  "chatgpt": {
    "selection": {
      "duration": 3.105958333333333,
      "text": "都到我身后。城门开着，我看谁敢进来。"
    },
    "intro": {
      "duration": 3.9555,
      "text": "脚下这道线，看清了？过线就得过我。"
    },
    "skill1": {
      "duration": 0.563375,
      "text": "回来！"
    },
    "skill2": {
      "duration": 0.608875,
      "text": "给我站住！"
    },
    "parry": {
      "duration": 0.7050416666666667,
      "text": "到此为止。"
    },
    "medium-selection": {
      "duration": 3.5467916666666666,
      "text": "霜翼骑士在此。城门的钥匙，交给我。"
    },
    "medium-intro": {
      "duration": 2.2484583333333332,
      "text": "这段路我亲自开。跟上。"
    },
    "medium-skill1": {
      "duration": 1.7729166666666667,
      "text": "霜翼，回旋！"
    },
    "medium-skill2": {
      "duration": 1.179125,
      "text": "龙印，起！"
    },
    "medium-parry": {
      "duration": 0.407,
      "text": "再来。"
    },
    "high-selection": {
      "duration": 3.65225,
      "text": "听见号角就看我的银翼。往哪飞，由我领。"
    },
    "high-intro": {
      "duration": 3.190541666666667,
      "text": "骑阵已齐。头一阵，我来。"
    },
    "high-skill1": {
      "duration": 1.1005833333333332,
      "text": "银刃折返！"
    },
    "high-skill2": {
      "duration": 0.46391666666666664,
      "text": "列盾！"
    },
    "high-parry": {
      "duration": 0.8885833333333333,
      "text": "这步你过不了。"
    },
    "extra-selection": {
      "duration": 3.32675,
      "text": "左翼升旗。看见我的龙纹，就向我合阵。"
    },
    "extra-intro": {
      "duration": 4.004666666666667,
      "text": "最后一队已进城。关门，该我们出阵了。"
    },
    "extra-skill1": {
      "duration": 1.22875,
      "text": "回刃合围！"
    },
    "extra-skill2": {
      "duration": 0.7474166666666666,
      "text": "封住缺口！"
    },
    "extra-parry": {
      "duration": 0.775375,
      "text": "阵线不退。"
    },
    "max-selection": {
      "duration": 3.509708333333333,
      "text": "这座城还没有名字的时候，就是我在守。"
    },
    "max-intro": {
      "duration": 2.8624583333333335,
      "text": "上一次有人来叩这道门，山还没这么高。"
    },
    "max-skill1": {
      "duration": 1.558,
      "text": "古环，归来！"
    },
    "max-skill2": {
      "duration": 0.6887083333333334,
      "text": "鳞阵合拢！"
    },
    "max-parry": {
      "duration": 1.70125,
      "text": "我的鳞，你破不开。"
    },
    "ultra-selection": {
      "duration": 3.207708333333333,
      "text": "群龙等我开口，才敢迎第一道晨光。"
    },
    "ultra-intro": {
      "duration": 3.7324166666666665,
      "text": "我已划下龙域。要向我挑战，就抬起头。"
    },
    "ultra-skill1": {
      "duration": 0.9199166666666667,
      "text": "天环归位！"
    },
    "ultra-skill2": {
      "duration": 0.7350416666666667,
      "text": "六印齐开！"
