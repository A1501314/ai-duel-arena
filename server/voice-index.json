      "text": "起刃！"
    },
    "high-parry": {
      "duration": 0.7175,
      "text": "驳回。"
    },
    "extra-selection": {
      "duration": 4.5175,
      "text": "花是送你的。斧子？那是我的餐具。"
    },
    "extra-intro": {
